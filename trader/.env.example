# Copy this file to trader/.env and fill in real values.
# trader/.env is gitignored — NEVER commit your real token.
#
# How to get these (one-time, ~5 minutes):
#  1. In Telegram, message @BotFather → /newbot → follow prompts → it gives a token.
#  2. Message your new bot anything (say "hi") so it's allowed to message you.
#  3. Get your chat id: open in a browser (token filled in):
#       https://api.telegram.org/bot<TOKEN>/getUpdates
#     Find "chat":{"id": <NUMBER> ...} — that number is your TELEGRAM_CHAT_ID.
#  4. Verify: python3 trader/scripts/notify.py --check

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Finnhub price API — REQUIRED for cloud routines (Yahoo 403s datacenter IPs).
# Free key (60 calls/min): sign up at https://finnhub.io/register, copy the key.
# Optional locally (Yahoo works without it); set it and quotes.py prefers Finnhub.
FINNHUB_API_KEY=
